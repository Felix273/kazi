# Set true only for local/demo testing. Payments complete immediately.
MPESA_MOCK=true

# Email OTP configuration (Gmail SMTP via app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
OTP_FROM_NAME=Kazi
OTP_FROM_EMAIL=

# sandbox or production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://REGION-PROJECT.cloudfunctions.net/mpesaCallback

# B2C withdrawal configuration (required only when MPESA_MOCK=false)
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://REGION-PROJECT.cloudfunctions.net/mpesaB2CResult
MPESA_B2C_TIMEOUT_URL=https://REGION-PROJECT.cloudfunctions.net/mpesaB2CTimeout
